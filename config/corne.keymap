#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "behaviors.dtsi"

#define HYPER LG(LC(LA(LSHIFT)))
#define CPY &kp LGUI(C)
#define PST &kp LGUI(V)
#define CUT &kp LGUI(X)

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mt HYPER TAB    &kp B        &kp L       &kp D      &kp W      &kp Z       &kp SQT &kp F      &kp O      &kp U       &kp J        &kp BSPC
                &kp LCTRL        &mt LSHFT N  &mt LCTRL R &mt LALT T &mt LGUI S &kp G       &kp Y   &mt RGUI H &mt RALT A &mt RCTRL E &mt RSHFT I  &kp FSLH
                &mt LC(LALT) DEL &kp Q        &mt CUT X   &kp M      &mt CPY C  &mt PST V   &kp K   &kp P      &kp SEMI   &kp COMMA   &kp DOT      &mt 3 ESC
                                                           &kp LGUI &mo 1 &mt LSHFT SPACE   &kp RET &mo 2  &kp RALT
            >;
        };

        lower_layer {
            bindings = <
                &mt HYPER TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6     &kp N7   &kp N8     &kp N9 &kp N0    &kp BSPC
                &trans           &trans       &trans       &trans       &trans       &trans         &trans     &kp LEFT &kp DOWN   &kp UP &kp RIGHT &trans
                &mt LC(LALT) DEL &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP   &kp C_PREV &kp C_PP &kp C_NEXT  &trans    &trans
                                                                  &kp LGUI &trans &mt LSHFT SPACE   &kp RET    &bt BT_CLR &trans
            >;
        };

        raise_layer {
            bindings = <
                &mt HYPER TAB    &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL        &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
                &mt LC(LALT) DEL &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                                       &kp LGUI &bt BT_SEL 0 &mt LSHFT SPACE   &kp RET   &trans    &lt 3 RALT
            >;
        };

        turkish_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &tr_o  &tr_u  &trans &trans
                &trans &trans &trans &trans &tr_s  &tr_g    &trans &trans &trans &trans &tr_i  &trans
                &trans &trans &trans &trans &tr_c  &trans   &trans &trans &trans &trans &trans &trans
                                      &trans &trans &mo 4   &trans &trans &trans
            >;
        };

        turkish_cap_layer {
            bindings = <
                &trans &trans &trans &trans &trans     &trans       &trans &trans &tr_o_cap &tr_u_cap &trans    &trans
                &trans &trans &trans &trans &tr_s_cap  &tr_g_cap    &trans &trans &trans    &trans    &tr_i_cap &trans
                &trans &trans &trans &trans &tr_c_cap  &trans       &trans &trans &trans    &trans    &trans    &trans
                                         &trans &trans &trans       &trans &trans &trans
            >;
        };
    };
};
