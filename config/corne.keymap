#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "turkish.dtsi"

#define HYPER LG(LC(LA(LSHFT)))

// Positional hand definitions for 36-key Corne layout
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    behaviors {
        // Left hand home row mods (triggered by right hand keys)
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Right hand home row mods (triggered by left hand keys)
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mt HYPER TAB          &kp B        &kp L        &kp D       &kp W       &kp Z                    &kp J   &kp F       &kp O       &kp U        &kp SQT      &kp BSPC
                &mt LG(LSHFT) LA(BSPC) &hml LSHFT N &hml LCTRL R &hml LALT T &hml LGUI S &kp G                    &kp Y   &hmr RGUI H &hmr RALT A &hmr RCTRL E &hmr RSHFT I &kp FSLH
                &mt LC(LALT) DEL       &kp Q        &kp X        &kp M       &kp C       &kp V                    &kp K   &kp P       &kp SEMI    &kp COMMA    &kp DOT      &mo 4
                                                                 &lt 3 K_APP &mo 1       &kp SPACE                &kp RET &mo 2       &kp ESC
            >;
        };

        lower_layer {
            bindings = <
                &trans &kp N1       &kp N2       &kp N3     &kp N4       &kp N5           &kp N6 &kp N7     &kp N8    &kp N9    &kp N0    &trans
                &trans &trans       &trans       &kp C_PREV &kp C_PP     &kp C_NEXT       &trans &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT &trans
                &trans &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP     &trans &kp HOME   &kp PG_UP &kp PG_DN &kp END   &trans
                                                 &trans     &trans       &trans           &trans &bt BT_CLR &trans
            >;
        };

        raise_layer {
            bindings = <
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR     &kp PRCNT        &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
                &trans &trans   &trans &trans   &trans       &trans           &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
                &trans &trans   &trans &trans   &trans       &trans           &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                                       &trans   &bt BT_SEL 0 &trans           &trans    &trans    &trans
            >;
        };

        number_layer {
            bindings = <
                &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5           &kp KP_PLUS  &kp KP_N7  &kp KP_N8  &kp KP_N9 &kp KP_MULTIPLY &trans
                &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10          &kp KP_MINUS &kp KP_N4  &kp KP_N5  &kp KP_N6 &kp KP_DIVIDE   &kp KP_EQUAL
                &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15          &kp KP_COMMA &kp KP_N1  &kp KP_N2  &kp KP_N3 &kp KP_LPAR     &kp KP_RPAR
                                          &trans &trans &trans          &kp KP_ENTER &kp KP_N0  &kp KP_DOT 
            >;
        };

        turkish_l_layer {
            bindings = <
                &trans &trans &trans &dragin   &trans      &trans          &trans &salesforce &tr_o_lower &tr_u_lower &trans      &trans
                &trans &trans &trans &tr_lira  &tr_s_lower &tr_g_lower     &trans &tr_hocam   &trans      &tr_engin   &tr_i_lower &mo 5
                &trans &trans &trans &tr_merve &tr_c_lower &trans          &trans &trans      &trans      &trans      &trans      &trans
                                   &trans      &trans      &trans          &trans &trans &trans
            >;
        };

        turkish_u_layer {
            bindings = <
                &trans &trans &trans &trans &trans      &trans          &trans &trans &tr_o_upper &tr_u_upper &trans      &trans
                &trans &trans &trans &trans &tr_s_upper &tr_g_upper     &trans &trans &trans      &trans      &tr_i_upper &trans
                &trans &trans &trans &trans &tr_c_upper &trans          &trans &trans &trans      &trans      &trans      &trans
                                &trans      &trans      &trans          &trans &trans &trans
            >;
        };

    };
};
