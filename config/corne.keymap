#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define HYPER LG(LC(LA(LSHIFT)))

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  B  |  L  |  D  |  W  |  Z  |   |  '  |  F   |  O  |  U  |  J  | BSPC |
// | CTRL |  N  |  R  |  T  |  S  |  G  |   |  Y  |  H   |  A  |  E  |  I  |  /   |
// | DEL |  Q  |  X  |  M  |  C  |  V  |   |  K  |  P   |  ;  |  ,  |  .  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &mt HYPER TAB    &kp B &kp L &kp D &kp W &kp Z   &kp SQT &kp F  &kp O    &kp U     &kp J    &kp BSPC
   &kp LCTRL        &kp N &kp R &kp T &kp S &kp G   &kp Y   &kp H  &kp A    &kp E     &kp I    &kp FSLH
   &mt LC(LALT) DEL &kp Q &kp X &kp M &kp C &kp V   &kp K   &kp P  &kp SEMI &kp COMMA &kp DOT  &kp ESC
                  &kp LGUI &mo 1 &mt LSHIFT SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     | LFT | DWN | UP  | RGHT|      |
// | DEL  |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &mt HYPER TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8   &kp N9 &kp N0    &kp BSPC
   &bt BT_CLR       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
   &mt LC(LALT) DEL &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans   &trans &trans    &trans
                                        &kp LGUI     &trans       &mt LSHIFT SPACE     &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | DEL  |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &mt HYPER TAB    &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL        &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &mt LC(LALT) DEL &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &mt LSHIFT SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
