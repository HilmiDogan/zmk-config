#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "turkish.dtsi"

#define HYPER LG(LC(LA(LSHFT)))

// Positional hand definitions for 36-key Corne layout
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    macros {
        // Cmd + key as one press and release, so holding the physical key
        // fires the shortcut exactly once (no OS key repeat).
        cmd_z: cmd_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LG(Z)>;
        };
        cmd_x: cmd_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LG(X)>;
        };
        cmd_c: cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LG(C)>;
        };
        cmd_v: cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LG(V)>;
        };
    };

    behaviors {
        // Left hand home row mods (triggered by right hand keys)
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Clipboard keys: tap = plain letter, hold = Cmd + letter, fired once.
        // Usage: &clip_c C C  (the first value is ignored, the macro already
        // knows which shortcut to send; the second value is the tap letter).
        // tap-preferred means any other key pressed while one of these is
        // undecided turns it into a tap, so rolls and fast typing never
        // trigger a shortcut. require-prior-idle-ms makes it resolve as a
        // tap instantly if you typed anything in the last 150 ms.
        clip_z: clipboard_hold_tap_z {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&cmd_z>, <&kp>;
        };

        clip_x: clipboard_hold_tap_x {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&cmd_x>, <&kp>;
        };

        clip_c: clipboard_hold_tap_c {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&cmd_c>, <&kp>;
        };

        clip_v: clipboard_hold_tap_v {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&cmd_v>, <&kp>;
        };

        // Right hand home row mods (triggered by left hand keys)
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mt HYPER TAB          &kp B        &kp L        &kp D       &kp W       &clip_z Z Z                    &kp J   &kp F       &kp O       &kp U        &kp SQT      &kp BSPC
                &mt LG(LSHFT) LA(BSPC) &hml LSHFT N &hml LCTRL R &hml LALT T &hml LGUI S &kp G                    &kp Y   &hmr RGUI H &hmr RALT A &hmr RCTRL E &hmr RSHFT I &kp FSLH
                &mt LC(LALT) DEL       &kp Q        &clip_x X X        &kp M       &clip_c C C       &clip_v V V                    &kp K   &kp P       &kp SEMI    &kp COMMA    &kp DOT      &kp ESC
                                                                 &lt 3 K_APP &mo 1       &kp SPACE                &kp RET &mo 2       &mo 4
            >;
        };

        lower_layer {
            bindings = <
                &trans &kp N1       &kp N2       &kp N3     &kp N4       &kp N5           &kp N6    &kp N7     &kp N8    &kp N9    &kp N0    &trans
                &trans &trans       &trans       &kp C_PREV &kp C_PP     &kp C_NEXT       &trans    &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT &trans
                &trans &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP     &trans    &kp HOME   &kp PG_UP &kp PG_DN &kp END   &trans
                                                 &trans     &trans       &trans           &trans    &bt BT_CLR &trans
            >;
        };

        raise_layer {
            bindings = <
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR     &kp PRCNT        &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
                &trans &trans   &trans &trans   &trans       &trans           &kp MINUS &kp EQUAL &kp BSLH  &kp LBKT &kp RBKT &kp GRAVE
                &trans &trans   &trans &trans   &trans       &trans           &kp UNDER &kp PLUS  &kp PIPE  &kp LBRC &kp RBRC &kp TILDE
                                       &trans   &bt BT_SEL 0 &trans           &trans    &trans    &trans
            >;
        };

        number_layer {
            bindings = <
                &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5           &kp KP_PLUS  &kp KP_N7  &kp KP_N8  &kp KP_N9 &kp KP_MULTIPLY &trans
                &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10          &kp KP_MINUS &kp KP_N4  &kp KP_N5  &kp KP_N6 &kp KP_DIVIDE   &trans
                &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15          &kp KP_COMMA &kp KP_N1  &kp KP_N2  &kp KP_N3 &kp KP_EQUAL    &trans
                                          &trans &trans &trans          &kp KP_ENTER &kp KP_N0  &kp KP_DOT 
            >;
        };

        turkish_l_layer {
            bindings = <
                &trans &trans &trans &trans &trans      &trans          &trans &trans &tr_o_lower &tr_u_lower &trans      &trans
                &trans &trans &trans &trans &tr_s_lower &tr_g_lower     &trans &trans &trans      &trans      &tr_i_lower &trans
                &trans &trans &trans &trans &tr_c_lower &trans          &trans &trans &trans      &trans      &trans      &trans
                                     &mo 5  &trans      &trans          &trans &trans &trans
            >;
        };

        turkish_u_layer {
            bindings = <
                &regards &trans &tr_lira &dragin &trans      &trans          &trans &salesforce &tr_o_upper &tr_u_upper &trans      &trans
                &trans   &trans &trans   &trans  &tr_s_upper &tr_g_upper     &trans &hocam      &trans      &email      &tr_i_upper &trans
                &trans   &trans &trans   &trans  &tr_c_upper &trans          &trans &pass       &trans      &trans      &trans      &trans
                                               &trans &trans &trans          &trans &trans &trans
            >;
        };

    };
};
